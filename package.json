{
  "name": "undying-scraper",
  "version": "0.1.0",
  "description": "Self-healing price/stock tracker — Bright Data × WeMakeDevs hackathon",
  "private": true,
  "scripts": {
    "pipeline": "node scripts/run-pipeline.js",
    "test": "node tests/brightdata-client.test.js",
    "test:integration": "node tests/pipeline-integration.test.js",
    "test:all": "node tests/brightdata-client.test.js && node tests/collector-registry.test.js && node tests/pipeline-integration.test.js",
    "test:mock": "node -e \"const m = require('./src/sources/mock-source'); console.log(JSON.stringify(m.generateMockProducts().slice(0,2), null, 2))\"",
    "test:heal": "node -e \"const h = require('./src/heal-check'); console.log(JSON.stringify(h.checkResult([]), null, 2))\""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "dotenv": "^16.3.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT"
}
