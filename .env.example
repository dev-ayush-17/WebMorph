# ─────────────────────────────────────────────────────────────────
# Undying Scraper — environment variables
# Copy this file to .env and fill in real values before running.
# NEVER commit your actual .env file.
# ─────────────────────────────────────────────────────────────────

# Supabase project credentials
# Create a project at https://supabase.com, then find these in:
#   Project Settings > API > Project URL / anon public key
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Discord incoming webhook URL (optional — leave empty to disable alerts)
# Create at: Server Settings > Integrations > Webhooks > New Webhook
DISCORD_WEBHOOK_URL=

# Bright Data collector ID (not needed until v0.2 — leave empty for now)
# Format: c_xxxxxxxxxxxxxxxxxx
BRIGHTDATA_COLLECTOR_ID=
